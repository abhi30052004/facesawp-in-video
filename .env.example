# BollySwap AI - Production & Development Environment Variables Example
# Copy this file to .env in backend/ or set these variables in the Render Dashboard

APP_NAME=BollySwap AI
APP_ENV=production
DEBUG=false
PORT=10000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Frontend URL & CORS
FRONTEND_URL=https://bollyswap.vercel.app
CORS_ORIGINS=["https://bollyswap.vercel.app","http://localhost:5173"]

# Groq AI Service Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=10.0

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
DATABASE_NAME=bollyswap

# Media Storage Configuration
# Note: Render free tier filesystem is ephemeral; for permanent asset retention, integrate Cloudflare R2 / S3
STORAGE_DIR=storage
MAX_VIDEO_SIZE_BYTES=104857600
MAX_IMAGE_SIZE_BYTES=10485760

# OpenCV YuNet Face Detection (CPU Only)
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.6
FACE_DETECTION_NMS_THRESHOLD=0.3
VIDEO_SAMPLE_INTERVAL_SECONDS=1.5
VIDEO_MAX_SAMPLED_FRAMES=30
VIDEO_MAX_FRAME_DIMENSION=1280

# Video Processing Pipeline
SWAP_MAX_FRAMES=300
SWAP_PROCESSING_TIMEOUT_SECONDS=120.0
SWAP_WATERMARK_TEXT=BollySwap AI • Synthetic Media
FACE_ALIGN_SIZE=256
FFMPEG_PATH=

# AI Face Swap Engine Configuration (Phase 5B - ONNX Runtime CPU)
# Set FACE_SWAP_ENABLED=true and point to an approved, licensed ONNX model
FACE_SWAP_ENABLED=false
FACE_SWAP_MODEL_PATH=models/face_swap_model.onnx
FACE_SWAP_MODEL_LICENSE=Commercial-Permissive
FACE_SWAP_PROVIDER=CPUExecutionProvider
FACE_SWAP_INPUT_SIZE=128

# Frontend Vercel Environment Variable:
# VITE_API_BASE_URL=https://your-render-service.onrender.com
