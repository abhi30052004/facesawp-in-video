# BollySwap AI - Backend Environment Configuration Example
APP_NAME=BollySwap AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Groq AI Service Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=10.0

# MongoDB Atlas Database Configuration
MONGODB_URI=
DATABASE_NAME=bollyswap

# Local Media Storage
STORAGE_DIR=storage
MAX_VIDEO_SIZE_BYTES=104857600
MAX_IMAGE_SIZE_BYTES=10485760

# OpenCV YuNet Face Detection Configuration (CPU Only)
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.6
FACE_DETECTION_NMS_THRESHOLD=0.3
VIDEO_SAMPLE_INTERVAL_SECONDS=1.5
VIDEO_MAX_SAMPLED_FRAMES=30
VIDEO_MAX_FRAME_DIMENSION=1280
